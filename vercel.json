{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/upload/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/posts/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai-detect/route.ts": {
      "maxDuration": 30
    }
  }
}
